import java.util.Vector;\par
class VectorDemo\par
\{\par
public static void main(String args[])\par
\{\par
Vector v = new Vector(6,2);\par
System.out.println("Initial size:" +v.size);\par
System.out.println("Initial Capacity:" +v.capacity());\par
v.addElement(new Integer(50));\par
v.addElement(new Float(0.27f));\par
v.addElement(new String (Hello));\par
v.addElement(new Integer(70));\par
System.out.println("capacity after 4 addition:" +v.capacity());\par
v.addElement(new Double(30.7));\par
System.out.println("Current capacity:" + v.capacity());\par
System.out.println("Current size:" +v.size());\par
v.addElement(new Double(76.90));\par
v.addElement(new Integer(7));\par
System.out.println("First element:" +(Integer)v.firstElement());\par
System.out.println("Last element:" +(Integer)v.lastElement());\par
if(v.contains(new Integer(50))\par
System.out.println("Vector contains 4.");\par
System.out.println("Vector:" +v.toString());\par
v.setSize(4);\par
System.out.println("Vector:" +v.toString());\par
Object o=new Object();\par
o=v.done()\par
System.out.println("New Vector:" +o);\par
v.removeALLElement();\par
if(v.isEmpty());\par
System.out.println("Vector is empty");\par
\}\par
\}\par
